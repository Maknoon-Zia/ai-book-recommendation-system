# ===================================================================
# .gitignore for Inkwell — AI Book Recommendation System
# ===================================================================

# ---- Virtual environment ----
venv/
.venv/
env/
ENV/

# ---- Python bytecode / cache ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Downloaded dataset ----
# Regenerated by download_data.py -- no reason to commit a 10k-row CSV,
# and it may carry its own licensing terms from Kaggle.
data/

# ---- Training-only artifacts ----
# NOT read by app.py at runtime -- only produced by / needed for
# re-running preprocess.py and train.py locally. Excluding these keeps
# the repo small and diffs clean.
artifacts/features.npy
artifacts/tfidf.joblib
artifacts/svd.joblib
artifacts/scaler.joblib
artifacts/meta.json
artifacts/hybrid_model.keras
artifacts/encoder.keras

# ---- Deployment artifacts: DO commit these ----
# The deployed Streamlit app reads these three files directly and will
# crash on startup without them (Streamlit Cloud does not run
# preprocess.py/train.py for you). Intentionally NOT listed above.
#   artifacts/books_clean.pkl
#   artifacts/embeddings.npy
#   artifacts/metrics.json

# ---- Kaggle credentials ----
# NEVER commit your API key. If kaggle.json ever ends up inside the repo
# folder by accident, this keeps it out of git.
kaggle.json
.kaggle/

# ---- Jupyter checkpoints (if you ever explore the data in a notebook) ----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---- Streamlit ----
# Local secrets file (API keys, etc.) if you ever add one -- do NOT commit.
.streamlit/secrets.toml

# ---- OS-specific junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- Logs ----
*.log

# ---- Distribution / packaging (in case pip build artifacts show up) ----
build/
dist/
*.egg-info/
