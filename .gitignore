# ===================================================================
# .gitignore for Inkwell — AI Book Recommendation System
# ===================================================================

# ---- Virtual environment ----
venv/
.venv/
env/
ENV/

# ---- Python bytecode / cache ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Downloaded dataset & generated artifacts ----
# These are all regenerated by download_data.py -> preprocess.py -> train.py
# Nobody cloning the repo needs these committed -- they need to be able
# to regenerate them, and committing 10k-row CSVs / trained models bloats
# the repo unnecessarily.
data/
artifacts/

# ---- Kaggle credentials ----
# NEVER commit your API key. If kaggle.json ever ends up inside the repo
# folder by accident, this keeps it out of git.
kaggle.json
.kaggle/

# ---- Jupyter checkpoints (if you ever explore the data in a notebook) ----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---- Streamlit ----
# Local secrets file (API keys, etc.) if you ever add one -- do NOT commit.
.streamlit/secrets.toml

# ---- OS-specific junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- Logs ----
*.log

# ---- Distribution / packaging (in case pip build artifacts show up) ----
build/
dist/
*.egg-info/